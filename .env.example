# Copier ce fichier en .env et renseigner les valeurs. NE JAMAIS COMMITER .env
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=finrag_docs

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=finrag
POSTGRES_PORT=5432

# --- Modèles ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- LLM (à renseigner plus tard, jamais commiter) ---
LLM_API_KEY=
